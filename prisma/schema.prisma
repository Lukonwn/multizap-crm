// ─────────────────────────────────────────────────────────────────────────────
// MultiZap CRM — schema do banco de dados
//
// Convenções:
//  - Todas as chaves primárias são UUID.
//  - Tabelas e colunas em snake_case no banco (@@map / @map).
//  - Todo dado operacional pertence a uma instância (account_id). O isolamento
//    é garantido pelo backend (repositórios com escopo) e pelas restrições abaixo.
//  - Credenciais nunca em texto aberto: colunas *_enc guardam AES-256-GCM.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum AccountStatus {
  NOT_CONFIGURED
  AWAITING_CONNECTION
  CONNECTED
  DISCONNECTED
  ATTENTION
  NEEDS_REPAIR // sessão encerrada pelo WhatsApp: requer novo pareamento
  DISABLED
}

enum ConnectionType {
  WHATSAPP_WEB // dispositivo conectado (QR Code / código de pareamento)
  EXTERNAL_DEVICE // aparelho apenas cadastrado: sem envio nem sincronização
}

enum ConsentStatus {
  PENDING
  GRANTED
  REVOKED
}

enum ContactOrigin {
  MANUAL
  IMPORT
  INBOUND
  OTHER
}

enum ConsentAction {
  GRANTED
  REVOKED
}

enum ImportStatus {
  UPLOADED
  ANALYZING
  ANALYZED
  CONFIRMED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  VALID
  DUPLICATE
  INVALID
  OPTED_OUT
  IMPORTED
  SKIPPED
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AssetKind {
  IMAGE
  BANNER
  TEXT
  LINK
  TEMPLATE
  FILE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  READY
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum RecipientStatus {
  PENDING
  SENDING // reservado atomicamente pelo gateway durante o envio
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

enum ConversationStatus {
  OPEN
  PENDING
  ANSWERED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum NotificationSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum NotificationCategory {
  CONNECTION
  PROCESSING
  IMPORT
  STORAGE
  INTEGRATION
  BACKUP
  SECURITY
  SYSTEM
}

// ─── Administração e sessões ────────────────────────────────────────────────

model AdminUser {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  name               String
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until")
  lastLoginAt        DateTime? @map("last_login_at")
  passwordChangedAt  DateTime? @map("password_changed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  sessions  AdminSession[]
  auditLogs AuditLog[]

  @@map("admin_users")
}

model AdminSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  csrfTokenHash String    @map("csrf_token_hash")
  ip            String?
  userAgent     String?   @map("user_agent")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

// ─── Instâncias e conexões ──────────────────────────────────────────────────

model Account {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  phoneE164      String?        @map("phone_e164")
  connectionType ConnectionType @map("connection_type")
  status         AccountStatus  @default(NOT_CONFIGURED)
  statusReason   String?        @map("status_reason")
  lastActivityAt DateTime?      @map("last_activity_at")
  disabledAt     DateTime?      @map("disabled_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  integration        Integration?
  integrationKeys    IntegrationKey[]
  connectionEvents   ConnectionEvent[]
  contacts           Contact[]
  tags               Tag[]
  consentEvents      ConsentEvent[]
  optOuts            OptOut[]
  imports            Import[]
  campaignAccounts   CampaignAccount[]
  campaignRecipients CampaignRecipient[]
  conversations      Conversation[]
  waIdentities       WaIdentity[]
  aiAgentLinks       AiAgentAccount[]
  messages           Message[]
  messageEvents      MessageEvent[]
  dailyMetrics       DailyMetric[]
  notifications      SystemNotification[]

  @@index([status])
  @@map("accounts")
}

/// Integração de uma instância. Para WHATSAPP_WEB guarda as credenciais da
/// sessão de dispositivo conectado (criptografadas). Remoção só manual.
model Integration {
  id             String    @id @default(uuid()) @db.Uuid
  accountId      String    @unique @map("account_id") @db.Uuid
  provider       String // "whatsapp-web" | "manual"
  credentialsEnc Bytes?    @map("credentials_enc")
  keyVersion     Int       @default(1) @map("key_version")
  waJid          String?   @map("wa_jid")
  deviceName     String?   @map("device_name")
  capabilities   Json      @default("{}")
  pairedAt       DateTime? @map("paired_at")
  lastCheckAt    DateTime? @map("last_check_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("integrations")
}

/// Chaves de sinalização da sessão (pre-keys, sessions, sender-keys...).
/// Valores sempre criptografados.
model IntegrationKey {
  id         String   @id @default(uuid()) @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  type       String
  keyId      String   @map("key_id")
  valueEnc   Bytes    @map("value_enc")
  keyVersion Int      @default(1) @map("key_version")
  updatedAt  DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, type, keyId])
  @@map("integration_keys")
}

model ConnectionEvent {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  type      String
  message   String?
  details   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("connection_events")
}

// ─── Contatos ───────────────────────────────────────────────────────────────

model Contact {
  id            String        @id @default(uuid()) @db.Uuid
  accountId     String        @map("account_id") @db.Uuid
  name          String?
  phoneE164     String        @map("phone_e164")
  origin        ContactOrigin @default(MANUAL)
  originDetail  String?       @map("origin_detail")
  consentStatus ConsentStatus @default(PENDING) @map("consent_status")
  consentAt     DateTime?     @map("consent_at")
  optedOutAt    DateTime?     @map("opted_out_at")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  account            Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tags               ContactTag[]
  consentEvents      ConsentEvent[]
  campaignRecipients CampaignRecipient[]
  conversations      Conversation[]
  importRows         ImportRow[]

  @@unique([accountId, phoneE164])
  @@index([accountId, consentStatus])
  @@index([accountId, createdAt])
  @@index([accountId, name])
  @@map("contacts")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  name      String
  color     String   @default("#10b981")
  createdAt DateTime @default(now()) @map("created_at")

  account  Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contacts ContactTag[]

  @@unique([accountId, name])
  @@map("tags")
}

model ContactTag {
  contactId String   @map("contact_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
  @@map("contact_tags")
}

model ConsentEvent {
  id        String        @id @default(uuid()) @db.Uuid
  accountId String        @map("account_id") @db.Uuid
  contactId String        @map("contact_id") @db.Uuid
  action    ConsentAction
  source    String
  evidence  String?
  createdAt DateTime      @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([contactId])
  @@map("consent_events")
}

/// Descadastramentos por telefone e instância. Persistem mesmo se o contato
/// for excluído, impedindo reinclusão via importação.
model OptOut {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  phoneE164 String   @map("phone_e164")
  reason    String?
  source    String
  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, phoneE164])
  @@map("opt_outs")
}

// ─── Importações e processamento de arquivos ────────────────────────────────

model Import {
  id              String       @id @default(uuid()) @db.Uuid
  accountId       String       @map("account_id") @db.Uuid
  fileName        String       @map("file_name")
  fileKey         String       @map("file_key")
  fileHash        String       @map("file_hash")
  fileSize        BigInt       @map("file_size")
  format          String
  status          ImportStatus @default(UPLOADED)
  columns         Json         @default("[]")
  mapping         Json         @default("{}")
  options         Json         @default("{}")
  totalRows       Int          @default(0) @map("total_rows")
  validRows       Int          @default(0) @map("valid_rows")
  duplicateRows   Int          @default(0) @map("duplicate_rows")
  invalidRows     Int          @default(0) @map("invalid_rows")
  optedOutRows    Int          @default(0) @map("opted_out_rows")
  existingRows    Int          @default(0) @map("existing_rows")
  importedRows    Int          @default(0) @map("imported_rows")
  updatedRows     Int          @default(0) @map("updated_rows")
  skippedRows     Int          @default(0) @map("skipped_rows")
  processedRows   Int          @default(0) @map("processed_rows")
  rejectedFileKey String?      @map("rejected_file_key")
  error           String?
  confirmedAt     DateTime?    @map("confirmed_at")
  startedAt       DateTime?    @map("started_at")
  finishedAt      DateTime?    @map("finished_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  rows    ImportRow[]

  @@index([accountId, createdAt])
  @@index([accountId, fileHash])
  @@map("imports")
}

model ImportRow {
  id                String          @id @default(uuid()) @db.Uuid
  importId          String          @map("import_id") @db.Uuid
  rowNumber         Int             @map("row_number")
  raw               Json
  name              String?
  phoneE164         String?         @map("phone_e164")
  status            ImportRowStatus
  reason            String?
  /// Contato já existente na instância com o mesmo telefone (duplicado na base).
  existingContactId String?         @map("existing_contact_id") @db.Uuid
  tags              String[]        @default([])
  notes             String?
  contactId         String?         @map("contact_id") @db.Uuid

  import  Import   @relation(fields: [importId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([importId, rowNumber])
  @@index([importId, status])
  @@map("import_rows")
}

model FileJob {
  id         String    @id @default(uuid()) @db.Uuid
  tool       String
  status     JobStatus @default(QUEUED)
  params     Json      @default("{}")
  inputKeys  Json      @default("[]") @map("input_keys")
  outputKeys Json      @default("[]") @map("output_keys")
  progress   Int       @default(0)
  summary    Json      @default("{}")
  error      String?
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("file_jobs")
}

// ─── Biblioteca de criativos ────────────────────────────────────────────────

model AssetFolder {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   AssetFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children AssetFolder[] @relation("FolderTree")
  assets   Asset[]

  @@index([parentId])
  @@map("asset_folders")
}

model Asset {
  id          String    @id @default(uuid()) @db.Uuid
  folderId    String?   @map("folder_id") @db.Uuid
  kind        AssetKind
  name        String
  storageKey  String?   @map("storage_key")
  mimeType    String?   @map("mime_type")
  sizeBytes   BigInt?   @map("size_bytes")
  width       Int?
  height      Int?
  sha256      String?
  textContent String?   @map("text_content")
  url         String?
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  folder           AssetFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  usages           AssetUsage[]
  campaigns        Campaign[]
  campaignAccounts CampaignAccount[]

  @@index([folderId])
  @@index([kind])
  @@map("assets")
}

model AssetUsage {
  id         String   @id @default(uuid()) @db.Uuid
  assetId    String   @map("asset_id") @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([assetId, campaignId])
  @@map("asset_usages")
}

// ─── Campanhas (modo assistido: cada envio confirmado pelo administrador) ──

model Campaign {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  status      CampaignStatus @default(DRAFT)
  body        String?
  linkUrl     String?        @map("link_url")
  assetId     String?        @map("asset_id") @db.Uuid
  audience    Json           @default("{}")
  scheduledAt DateTime?      @map("scheduled_at")
  startedAt   DateTime?      @map("started_at")
  completedAt DateTime?      @map("completed_at")
  cancelledAt DateTime?      @map("cancelled_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  asset    Asset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)
  accounts CampaignAccount[]
  usages   AssetUsage[]
  metrics  CampaignMetric[]

  @@index([status])
  @@index([scheduledAt])
  @@map("campaigns")
}

/// Campanha-filho: uma por instância, com público, configuração e resultado próprios.
model CampaignAccount {
  id              String         @id @default(uuid()) @db.Uuid
  campaignId      String         @map("campaign_id") @db.Uuid
  accountId       String         @map("account_id") @db.Uuid
  status          CampaignStatus @default(DRAFT)
  body            String?
  linkUrl         String?        @map("link_url")
  assetId         String?        @map("asset_id") @db.Uuid
  audience        Json           @default("{}")
  scheduledAt     DateTime?      @map("scheduled_at")
  totalRecipients Int            @default(0) @map("total_recipients")
  sentCount       Int            @default(0) @map("sent_count")
  failedCount     Int            @default(0) @map("failed_count")
  skippedCount    Int            @default(0) @map("skipped_count")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  campaign   Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  account    Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset      Asset?              @relation(fields: [assetId], references: [id], onDelete: SetNull)
  recipients CampaignRecipient[]
  metric     CampaignMetric?

  @@unique([campaignId, accountId])
  @@index([accountId, status])
  @@map("campaign_accounts")
}

model CampaignRecipient {
  id                String          @id @default(uuid()) @db.Uuid
  campaignAccountId String          @map("campaign_account_id") @db.Uuid
  accountId         String          @map("account_id") @db.Uuid
  contactId         String          @map("contact_id") @db.Uuid
  phoneE164         String          @map("phone_e164")
  status            RecipientStatus @default(PENDING)
  error             String?
  confirmedAt       DateTime?       @map("confirmed_at")
  sentAt            DateTime?       @map("sent_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  campaignAccount CampaignAccount @relation(fields: [campaignAccountId], references: [id], onDelete: Cascade)
  account         Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact         Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  message         Message?

  @@unique([campaignAccountId, contactId])
  @@index([campaignAccountId, status])
  @@map("campaign_recipients")
}

// ─── Mensagens ──────────────────────────────────────────────────────────────

model Conversation {
  id                 String             @id @default(uuid()) @db.Uuid
  accountId          String             @map("account_id") @db.Uuid
  contactId          String?            @map("contact_id") @db.Uuid
  remoteJid          String             @map("remote_jid")
  title              String?
  status             ConversationStatus @default(OPEN)
  unreadCount        Int                @default(0) @map("unread_count")
  lastMessageAt      DateTime?          @map("last_message_at")
  lastMessagePreview String?            @map("last_message_preview")
  /// Telefone do contato quando o WhatsApp o informa (conversas por LID podem não ter).
  phoneE164          String?            @map("phone_e164")
  /// Foto de perfil guardada no bucket (obtida do WhatsApp, só de conversas existentes).
  photoKey           String?            @map("photo_key")
  photoCheckedAt     DateTime?          @map("photo_checked_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  account  Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact  Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages Message[]
  aiState  AiConversationState?
  aiDrafts AiDraft[]

  @@unique([accountId, remoteJid])
  @@index([accountId, lastMessageAt])
  @@index([accountId, status])
  @@map("conversations")
}

/// Diretório de identidades do aparelho conectado: nomes salvos no celular, nomes de
/// perfil e a correspondência LID ↔ telefone, como o WhatsApp entrega à sessão.
/// NÃO são contatos do CRM: não aparecem em Contatos nem entram em campanhas.
model WaIdentity {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  /// Identificador principal como entregue pelo WhatsApp (telefone ou LID).
  jid          String
  lid          String?
  phoneE164    String?  @map("phone_e164")
  savedName    String?  @map("saved_name")
  pushName     String?  @map("push_name")
  verifiedName String?  @map("verified_name")
  updatedAt    DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, jid])
  @@index([accountId, lid])
  @@index([accountId, phoneE164])
  @@map("wa_identities")
}

model Message {
  id                  String           @id @default(uuid()) @db.Uuid
  accountId           String           @map("account_id") @db.Uuid
  conversationId      String           @map("conversation_id") @db.Uuid
  providerMessageId   String           @map("provider_message_id")
  direction           MessageDirection
  type                String           @default("text")
  body                String?
  mediaKey            String?          @map("media_key")
  status              MessageStatus
  campaignRecipientId String?          @unique @map("campaign_recipient_id") @db.Uuid
  sentAt              DateTime         @map("sent_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  account           Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversation      Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  campaignRecipient CampaignRecipient? @relation(fields: [campaignRecipientId], references: [id], onDelete: SetNull)
  events            MessageEvent[]
  aiLink            AiMessageLink?

  @@unique([accountId, providerMessageId])
  @@index([conversationId, sentAt])
  @@map("messages")
}

model MessageEvent {
  id         String        @id @default(uuid()) @db.Uuid
  messageId  String        @map("message_id") @db.Uuid
  accountId  String        @map("account_id") @db.Uuid
  status     MessageStatus
  occurredAt DateTime      @map("occurred_at")
  details    Json          @default("{}")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, occurredAt])
  @@index([messageId])
  @@map("message_events")
}

// ─── Métricas (calculadas a partir de eventos reais) ───────────────────────

model CampaignMetric {
  id                String   @id @default(uuid()) @db.Uuid
  campaignId        String   @map("campaign_id") @db.Uuid
  campaignAccountId String   @unique @map("campaign_account_id") @db.Uuid
  recipients        Int      @default(0)
  sent              Int      @default(0)
  delivered         Int      @default(0)
  read              Int      @default(0)
  failed            Int      @default(0)
  replied           Int      @default(0)
  updatedAt         DateTime @updatedAt @map("updated_at")

  campaign        Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignAccount CampaignAccount @relation(fields: [campaignAccountId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_metrics")
}

model DailyMetric {
  id                 String   @id @default(uuid()) @db.Uuid
  date               DateTime @db.Date
  accountId          String   @map("account_id") @db.Uuid
  contactsCreated    Int      @default(0) @map("contacts_created")
  consentsGranted    Int      @default(0) @map("consents_granted")
  optOuts            Int      @default(0) @map("opt_outs")
  campaignsCreated   Int      @default(0) @map("campaigns_created")
  campaignsCompleted Int      @default(0) @map("campaigns_completed")
  messagesSent       Int      @default(0) @map("messages_sent")
  messagesDelivered  Int      @default(0) @map("messages_delivered")
  messagesRead       Int      @default(0) @map("messages_read")
  messagesFailed     Int      @default(0) @map("messages_failed")
  messagesReceived   Int      @default(0) @map("messages_received")
  updatedAt          DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([date, accountId])
  @@map("daily_metrics")
}

// ─── Auditoria, notificações e sistema ──────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  accountId  String?  @map("account_id") @db.Uuid
  ip         String?
  userAgent  String?  @map("user_agent")
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([accountId, createdAt])
  @@map("audit_logs")
}

model SystemNotification {
  id         String               @id @default(uuid()) @db.Uuid
  severity   NotificationSeverity
  category   NotificationCategory
  title      String
  message    String
  accountId  String?              @map("account_id") @db.Uuid
  dedupeKey  String?              @map("dedupe_key")
  readAt     DateTime?            @map("read_at")
  resolvedAt DateTime?            @map("resolved_at")
  createdAt  DateTime             @default(now()) @map("created_at")

  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([readAt, createdAt])
  @@index([dedupeKey])
  @@map("system_notifications")
}

model SystemEvent {
  id        String   @id @default(uuid()) @db.Uuid
  source    String // api | worker | gateway | web
  level     String // info | warn | error
  type      String
  message   String
  details   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([source, level])
  @@map("system_events")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Backup {
  id         String    @id @default(uuid()) @db.Uuid
  status     JobStatus @default(QUEUED)
  trigger    String // scheduled | manual
  dbKey      String?   @map("db_key")
  filesKey   String?   @map("files_key")
  sizeBytes  BigInt?   @map("size_bytes")
  error      String?
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("backups")
}

// ─── MultiZap AI (Entrega 1: personas, agentes, versões, laboratório) ───────

enum AiAgentMode {
  REVIEW // a IA escreve o rascunho; o administrador envia
  AUTO // a IA envia sozinha (ligado explicitamente pelo administrador)
}

enum AiAgentStatus {
  DRAFT
  ACTIVE
  PAUSED
  ERROR
}

enum AiDraftStatus {
  PENDING
  SENT
  DISCARDED
  FAILED
}

enum AiUsageContext {
  TEST
  LIVE
}

enum AiEventCategory {
  WHATSAPP
  OPENROUTER
  AGENT
  KNOWLEDGE
  DELIVERY
}

/// Credenciais de provedores de IA (a chave fica sempre criptografada).
model AiCredential {
  id         String    @id @default(uuid()) @db.Uuid
  provider   String    @unique // "openrouter"
  keyEnc     Bytes     @map("key_enc")
  keyVersion Int       @default(1) @map("key_version")
  keyLast4   String    @map("key_last4")
  lastTestAt DateTime? @map("last_test_at")
  lastTestOk Boolean?  @map("last_test_ok")
  lastError  String?   @map("last_error")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("ai_credentials")
}

/// Persona (personagem) reutilizável por vários agentes. is_template = modelo.
model AiPersona {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  isTemplate         Boolean  @default(false) @map("is_template")
  age                Int?
  identity           String?
  biography          String?
  backstory          String?
  personality        String?
  traits             String?
  toneOfVoice        String?  @map("tone_of_voice")
  communicationStyle String?  @map("communication_style")
  formality          String   @default("neutral") // formal | neutral | informal
  emojiUsage         String   @default("low") @map("emoji_usage") // none | low | medium | high
  responseLength     String   @default("short") @map("response_length") // short | medium | long
  conversationStart  String?  @map("conversation_start")
  expressions        String[] @default([])
  instructions       String?
  rules              String?
  allowedTopics      String?  @map("allowed_topics")
  restrictedTopics   String?  @map("restricted_topics")
  openingMessages    String[] @default([]) @map("opening_messages")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  revisions AiPersonaRevision[]
  agents    AiAgent[]

  @@index([isTemplate, name])
  @@map("ai_personas")
}

/// Histórico de alterações de uma persona (fotografia completa a cada edição).
model AiPersonaRevision {
  id        String   @id @default(uuid()) @db.Uuid
  personaId String   @map("persona_id") @db.Uuid
  snapshot  Json
  summary   String
  changedBy String?  @map("changed_by")
  createdAt DateTime @default(now()) @map("created_at")

  persona AiPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([personaId, createdAt])
  @@map("ai_persona_revisions")
}

/// Agente operacional: persona + modelo + regras próprias de operação.
model AiAgent {
  id                 String        @id @default(uuid()) @db.Uuid
  name               String
  personaId          String        @map("persona_id") @db.Uuid
  model              String
  temperature        Float?
  maxTokens          Int           @default(400) @map("max_tokens")
  instructions       String?
  memoryEnabled      Boolean       @default(true) @map("memory_enabled")
  mode               AiAgentMode   @default(REVIEW)
  status             AiAgentStatus @default(DRAFT)
  /// Intervalo mínimo (s) entre a mensagem do contato e o envio automático, e entre respostas.
  minIntervalSeconds Int           @default(8) @map("min_interval_seconds")
  /// Mostra "digitando…" ao contato enquanto a resposta é realmente gerada (modo automático).
  showTyping         Boolean       @default(true) @map("show_typing")
  maxRepliesPerHour  Int           @default(10) @map("max_replies_per_hour")
  publishedVersionId String?       @unique @map("published_version_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  persona          AiPersona        @relation(fields: [personaId], references: [id], onDelete: Restrict)
  versions         AiAgentVersion[] @relation("AgentVersions")
  publishedVersion AiAgentVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  accounts         AiAgentAccount[]
  testSessions     AiTestSession[]
  usage            AiTokenUsage[]
  events           AiAgentEvent[]
  drafts           AiDraft[]
  messageLinks     AiMessageLink[]

  @@index([status])
  @@map("ai_agents")
}

/// Versão publicada de um agente: fotografia da configuração e da persona usadas.
model AiAgentVersion {
  id        String   @id @default(uuid()) @db.Uuid
  agentId   String   @map("agent_id") @db.Uuid
  number    Int
  snapshot  Json
  note      String?
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  agent       AiAgent  @relation("AgentVersions", fields: [agentId], references: [id], onDelete: Cascade)
  publishedBy AiAgent? @relation("PublishedVersion")

  @@unique([agentId, number])
  @@map("ai_agent_versions")
}

/// Vínculo agente ↔ instância de WhatsApp (só um agente ATIVO por instância).
model AiAgentAccount {
  id        String   @id @default(uuid()) @db.Uuid
  agentId   String   @map("agent_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  agent   AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([agentId, accountId])
  @@index([accountId])
  @@map("ai_agent_accounts")
}

/// Sessão do laboratório (simulação: nunca envia mensagens reais).
model AiTestSession {
  id        String   @id @default(uuid()) @db.Uuid
  agentId   String   @map("agent_id") @db.Uuid
  source    String // draft | published
  versionId String?  @map("version_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  agent    AiAgent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages AiTestMessage[]

  @@index([agentId, createdAt])
  @@map("ai_test_sessions")
}

model AiTestMessage {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  role      String // user | assistant | error
  content   String
  debug     Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  session AiTestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("ai_test_messages")
}

/// Consumo de tokens e custo de cada chamada ao modelo.
model AiTokenUsage {
  id               String         @id @default(uuid()) @db.Uuid
  agentId          String?        @map("agent_id") @db.Uuid
  accountId        String?        @map("account_id") @db.Uuid
  context          AiUsageContext
  model            String
  promptTokens     Int            @default(0) @map("prompt_tokens")
  completionTokens Int            @default(0) @map("completion_tokens")
  /// Custo em dólares. cost_confirmed = informado pela OpenRouter; senão, estimado pela tabela de preços.
  costUsd          Decimal?       @map("cost_usd") @db.Decimal(14, 8)
  costConfirmed    Boolean        @default(false) @map("cost_confirmed")
  latencyMs        Int?           @map("latency_ms")
  /// Conversa atendida (somente uso real); sem chave estrangeira para sobreviver à exclusão.
  conversationId   String?        @map("conversation_id") @db.Uuid
  /// reply | memory
  purpose          String?
  createdAt        DateTime       @default(now()) @map("created_at")

  agent AiAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([agentId, createdAt])
  @@index([accountId, createdAt])
  @@index([createdAt])
  @@map("ai_token_usage")
}

/// Eventos operacionais dos agentes, separados pela origem do problema.
model AiAgentEvent {
  id        String          @id @default(uuid()) @db.Uuid
  agentId   String?         @map("agent_id") @db.Uuid
  category  AiEventCategory
  level     String // info | warn | error
  message   String
  details   Json            @default("{}")
  createdAt DateTime        @default(now()) @map("created_at")

  agent AiAgent? @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([category, createdAt])
  @@map("ai_agent_events")
}

/// Estado da IA em uma conversa: pausa (humano assumiu), liberação manual e memória do contato.
model AiConversationState {
  id              String    @id @default(uuid()) @db.Uuid
  conversationId  String    @unique @map("conversation_id") @db.Uuid
  paused          Boolean   @default(false)
  /// admin | phone | campaign | limit | system
  pausedBy        String?   @map("paused_by")
  pausedReason    String?   @map("paused_reason")
  pausedAt        DateTime? @map("paused_at")
  /// Liberação manual: atende mesmo após campanha recente.
  enabledOverride Boolean   @default(false) @map("enabled_override")
  lastReplyAt     DateTime? @map("last_reply_at")
  lastSkip        String?   @map("last_skip")
  lastSkipAt      DateTime? @map("last_skip_at")
  memory          String?
  memoryAgentId   String?   @map("memory_agent_id") @db.Uuid
  memoryUpdatedAt DateTime? @map("memory_updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_conversation_states")
}

/// Resposta sugerida (ou enviada) pelo agente a uma mensagem recebida. A restrição única em
/// `inbound_message_id` garante uma única resposta por mensagem, mesmo com jobs repetidos.
model AiDraft {
  id               String        @id @default(uuid()) @db.Uuid
  conversationId   String        @map("conversation_id") @db.Uuid
  agentId          String        @map("agent_id") @db.Uuid
  versionId        String?       @map("version_id") @db.Uuid
  inboundMessageId String        @unique @map("inbound_message_id") @db.Uuid
  body             String
  status           AiDraftStatus @default(PENDING)
  /// Texto de fato enviado (se o administrador editou).
  sentBody         String?       @map("sent_body")
  messageId        String?       @map("message_id") @db.Uuid
  autoSent         Boolean       @default(false) @map("auto_sent")
  decidedAt        DateTime?     @map("decided_at")
  createdAt        DateTime      @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        AiAgent      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([agentId, status])
  @@map("ai_drafts")
}

/// Marca as mensagens enviadas por um agente (automáticas ou aprovadas pelo administrador).
model AiMessageLink {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @unique @map("message_id") @db.Uuid
  agentId   String   @map("agent_id") @db.Uuid
  /// auto | review
  source    String
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  agent   AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@map("ai_message_links")
}
