# ─── MultiZap CRM ─ variáveis de ambiente ───────────────────────────────
# Copie para .env em desenvolvimento. Em produção, configure na Railway.
# NUNCA faça commit de valores reais.

NODE_ENV=development

# Banco e fila (Railway: referencie ${{Postgres.DATABASE_URL}} e ${{Redis.REDIS_URL}})
DATABASE_URL=postgresql://multizap:multizap@localhost:5432/multizap
REDIS_URL=redis://localhost:6379

# ─── API ───
API_PORT=4000
# Origem pública do painel (usada na verificação de Origin/CSRF)
WEB_ORIGIN=http://localhost:3000
# Chave mestra de criptografia de credenciais: 32 bytes em base64
#   gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_MASTER_KEY=
# Versão da chave acima (incrementar ao rotacionar)
CREDENTIALS_KEY_VERSION=1
# Token para chamadas internas entre serviços (worker/gateway → api)
INTERNAL_API_TOKEN=
# Duração das sessões administrativas
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=12

# Administrador inicial (criado na primeira inicialização se não existir).
# A troca de senha é obrigatória no primeiro login.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ─── WEB ───
# URL interna da API (Railway: http://${{multizap-api.RAILWAY_PRIVATE_DOMAIN}}:4000)
API_INTERNAL_URL=http://localhost:4000

# ─── Armazenamento (Railway Bucket, compatível com S3) ── Fase 3+
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# ─── Backups (bucket separado) ── Fase 9+
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# ─── Testes ───
TEST_DATABASE_URL=postgresql://multizap:multizap@localhost:5432/multizap_test
