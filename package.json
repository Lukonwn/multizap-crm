{
  "name": "multizap-crm",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @multizap/database db:generate",
    "db:migrate": "pnpm --filter @multizap/database db:migrate",
    "db:deploy": "pnpm --filter @multizap/database db:deploy",
    "db:seed": "pnpm --filter @multizap/database db:seed",
    "postinstall": "pnpm --filter @multizap/database db:generate",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
